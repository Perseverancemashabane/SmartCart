generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  STAFF — for anti-theft PIN + admin access
// ============================================================
model Staff {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  pinHash   String    @map("pin_hash") @db.VarChar(200)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("staff")
}

// ============================================================
//  PRODUCT
// ============================================================
model Product {
  id            Int                @id @default(autoincrement())
  name          String             @db.VarChar(200)
  priceCents    Int                @map("price_cents")
  stockQuantity Int?               @default(0) @map("stock_quantity")
  // Legacy — kept during migration, will be dropped later
  rfidTagId     String?            @unique @map("rfid_tag_id") @db.VarChar(50)
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  tags          ProductTag[]
  cartItems     CartItem[]
  shoppingItems ShoppingListItem[]

  @@map("products")
}

// ============================================================
//  PRODUCT TAG — multiple tags per product
// ============================================================
model ProductTag {
  id         Int      @id @default(autoincrement())
  rfidTagId  String   @unique @map("rfid_tag_id") @db.VarChar(50)
  productId  Int      @map("product_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_tags")
}

// ============================================================
//  CART
// ============================================================
model Cart {
  id             String        @id @db.VarChar(50)
  stationRfidTag String        @unique @map("station_rfid_tag") @db.VarChar(50)
  status         String?       @default("available") @db.VarChar(20)
  lastDockedAt   DateTime?     @map("last_docked_at") @db.Timestamp(6)
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  sessions       CartSession[]

  @@map("carts")
}

// ============================================================
//  CART SESSION
// ============================================================
model CartSession {
  id            Int           @id @default(autoincrement())
  cartId        String        @map("cart_id") @db.VarChar(50)
  customerId    Int?          @map("customer_id")
  isActive      Boolean?      @default(true) @map("is_active")
  isDocked      Boolean?      @default(false) @map("is_docked")
  subtotalCents Int?          @default(0) @map("subtotal_cents")
  taxCents      Int?          @default(0) @map("tax_cents")
  totalCents    Int?          @default(0) @map("total_cents")
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  closedAt      DateTime?     @map("closed_at") @db.Timestamp(6)

  // Premium fields
  paymentStatus      String    @default("unpaid") @map("payment_status") @db.VarChar(20)
  paymentRequestedAt DateTime? @map("payment_requested_at") @db.Timestamp(6)
  cartAbandoned      Boolean   @default(false) @map("cart_abandoned")
  alarmTriggered     Boolean   @default(false) @map("alarm_triggered")

  items         CartItem[]
  cart          Cart          @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer?     @relation(fields: [customerId], references: [id])
  transactions  Transaction[]

  @@map("cart_sessions")
}

// ============================================================
//  CART ITEM
// ============================================================
model CartItem {
  id                 Int       @id @default(autoincrement())
  sessionId          Int
  productId          Int
  quantity           Int       @default(1)
  unitPriceCents     Int
  subtotalCents      Int
  sku                String?   // <--- ADD THIS LINE HERE
  created_at         DateTime? @default(now())
  confirmedByWatcher Boolean   @default(false)
  removeRequestedAt  DateTime?

  session            CartSession @relation(fields: [sessionId], references: [id])
  product            Product     @relation(fields: [productId], references: [id])
}

// ============================================================
//  TRANSACTION
// ============================================================
model Transaction {
  id                    Int         @id @default(autoincrement())
  sessionId             Int         @map("session_id")
  stripePaymentIntentId String?     @unique @map("stripe_payment_intent_id") @db.VarChar(200)
  amountCents           Int         @map("amount_cents")
  currency              String?     @default("ZAR") @db.VarChar(10)
  status                String?     @default("pending") @db.VarChar(50)
  createdAt             DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  session               CartSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("transactions")
}

// ============================================================
//  LEGACY items (used by /api/scan)
// ============================================================
model items {
  id      Int     @id @default(autoincrement())
  tag_uid String  @unique @db.VarChar(20)
  name    String  @db.VarChar(100)
  price   Decimal @db.Decimal(10, 2)
}

// ============================================================
//  LEGACY scans
// ============================================================
model scans {
  id         Int       @id @default(autoincrement())
  tag_uid    String    @db.VarChar(20)
  name       String?   @db.VarChar(100)
  price      Decimal?  @db.Decimal(10, 2)
  scanned_at DateTime? @default(now()) @db.Timestamp(6)
}

// ============================================================
//  CUSTOMER
// ============================================================
model Customer {
  id                   Int                 @id @default(autoincrement())
  phoneNumber          String              @unique @map("phone_number") @db.VarChar(20)
  email                String?             @unique @db.VarChar(200)
  name                 String?             @db.VarChar(100)
  walletBalanceCents   Int                 @default(0) @map("wallet_balance_cents")
  pinHash              String?             @map("pin_hash") @db.VarChar(100)
  failedLoginAttempts  Int                 @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?           @map("locked_until") @db.Timestamp(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  cartSessions         CartSession[]
  walletTransactions   WalletTransaction[]
  shoppingLists        ShoppingList[]

  @@map("customers")
}

// ============================================================
//  WALLET TRANSACTION
// ============================================================
model WalletTransaction {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  amountCents Int      @map("amount_cents")
  type        String   @db.VarChar(20)
  status      String   @default("completed") @db.VarChar(20)
  reference   String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  customer    Customer @relation(fields: [customerId], references: [id])

  @@map("wallet_transactions")
}

// ============================================================
//  SHOPPING LIST
// ============================================================
model ShoppingList {
  id          Int                @id @default(autoincrement())
  customerId  Int                @map("customer_id")
  name        String?            @db.VarChar(100)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  completedAt DateTime?          @map("completed_at") @db.Timestamp(6)
  isActive    Boolean            @default(true) @map("is_active")
  customer    Customer           @relation(fields: [customerId], references: [id])
  items       ShoppingListItem[]

  @@index([customerId, isActive])
  @@map("shopping_lists")
}

// ============================================================
//  SHOPPING LIST ITEM
// ============================================================
model ShoppingListItem {
  id         Int          @id @default(autoincrement())
  listId     Int          @map("list_id")
  productId  Int?         @map("product_id")
  customName String?      @map("custom_name") @db.VarChar(100)
  quantity   Int          @default(1)
  isScanned  Boolean      @default(false) @map("is_scanned")
  scannedAt  DateTime?    @map("scanned_at") @db.Timestamp(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(6)

  // Premium field
  removeRequestedAt DateTime? @map("remove_requested_at") @db.Timestamp(6)

  list       ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product    Product?     @relation(fields: [productId], references: [id])

  @@map("shopping_list_items")
}

// ============================================================
//  ALERT — for anti-theft, abandoned cart, and other incidents
// ============================================================
model Alert {
  id          Int       @id @default(autoincrement())
  cartId      String    @map("cart_id") @db.VarChar(50)
  sessionId   Int?      @map("session_id")
  type        String    @db.VarChar(50)   // "anti_theft", "abandoned", etc.
  reason      String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedBy  String?   @map("resolved_by") @db.VarChar(100)
  resolution  String?   @db.VarChar(50)   // "continue", "cancel"

  @@index([cartId])
  @@index([createdAt])
  @@map("alerts")
}

// ============================================================
//  ADMIN SESSION — persistent admin login tokens
// ============================================================
model AdminSession {
  id         Int       @id @default(autoincrement())
  token      String    @unique @db.VarChar(128)
  staffId    Int       @map("staff_id")
  staffName  String    @map("staff_name") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)

  @@index([expiresAt])
  @@map("admin_sessions")
}